# Downloaded corpora, caches and generated datasets are large and reproducible:
# never commit them.
data/raw/
data/cache/
data/processed/
data/audit/

# Keep the directory layout in git.
!data/**/.gitkeep

# Local engine binaries (Stockfish is GPL-3.0 and never vendored).
tools/

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.log